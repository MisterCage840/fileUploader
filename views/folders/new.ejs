<%- include("../partials/top", { title: "New folder" }) %>

<h2>New folder</h2>

<% if (errors.length) { %>
<div class="alert alert--error">
  <ul class="list list--plain">
  <% errors.forEach(e => { %>
  <li><%= e.msg %></li>
  <% }) %>
  </ul>
</div>
<% } %>

<form class="form" method="post" action="/folders">
  <input
    name="name"
    placeholder="Folder name"
    value="<%= values.name %>"
    required
  />
  <button type="submit">Create</button>
</form>

<p><a href="/folders">Back</a></p>
<%- include("../partials/bottom") %>
